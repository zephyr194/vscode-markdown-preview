{
  "name": "copilot-markdown-preview",
  "displayName": "Copilot Markdown Preview",
  "description": "%extension.description%",
  "version": "0.1.3",
  "publisher": "zephyr14",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zephyr194/vscode-markdown-preview.git"
  },
  "keywords": [
    "markdown",
    "markdown preview",
    "ai",
    "copilot",
    "copilot chat",
    "plan",
    "latex",
    "mermaid"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "copilot.markdown.preview.editor",
        "displayName": "%customEditor.displayName%",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "copilot.markdown.preview.showSource",
        "title": "%command.showSource.title%",
        "icon": "$(edit)"
      },
      {
        "command": "copilot.markdown.preview.showPreview",
        "title": "%command.showPreview.title%",
        "icon": "$(open-preview)"
      },
      {
        "command": "copilot.markdown.preview.clearComments",
        "title": "%command.clearComments.title%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "copilot.markdown.preview.showSource",
          "when": "activeCustomEditorId == copilot.markdown.preview.editor",
          "group": "navigation"
        },
        {
          "command": "copilot.markdown.preview.showPreview",
          "when": "resourceLangId == markdown && activeCustomEditorId != copilot.markdown.preview.editor",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "copilot.markdown.preview.fontFamily": {
          "type": "string",
          "default": "",
          "description": "%configuration.fontFamily.description%"
        },
        "copilot.markdown.preview.chineseFontFamily": {
          "type": "string",
          "default": "",
          "description": "%configuration.chineseFontFamily.description%"
        },
        "copilot.markdown.preview.codeFontFamily": {
          "type": "string",
          "default": "",
          "description": "%configuration.codeFontFamily.description%"
        },
        "copilot.markdown.preview.fontSize": {
          "type": "number",
          "default": 0,
          "description": "%configuration.fontSize.description%"
        },
        "copilot.markdown.preview.lineHeight": {
          "type": "number",
          "default": 1.6,
          "description": "%configuration.lineHeight.description%"
        },
        "copilot.markdown.preview.openAsDefault": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.openAsDefault.description%"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production"
  },
  "dependencies": {
    "unified": "^11.0.5",
    "remark-parse": "^11.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-rehype": "^11.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "unist-util-visit": "^5.0.0",
    "katex": "^0.16.11",
    "mermaid": "^11.4.1",
    "@vscode/codicons": "^0.0.36"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/node": "^20.14.0",
    "@types/hast": "^3.0.4",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.4"
  }
}
